#!/usr/bin/with-contenv bash
# 1. Starts Flask setup UI on port 32400
# 2. Waits for user to complete OAuth (/tmp/plex-claim written by Flask)
# 3. Kills Flask, starts Plex on 32400 with PLEX_CLAIM injected
# 4. Post-install hook runs inside setup_server.py background thread

SIGNAL_FILE="/tmp/plex-claim"
SETUP_PID_FILE="/tmp/setup-server.pid"
TIMEOUT=600
ELAPSED=0
INTERVAL=3

home="$(echo ~plex)"
export PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR="${PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR:-${home}/Library/Application Support}"
export PLEX_MEDIA_SERVER_HOME=/usr/lib/plexmediaserver
export PLEX_MEDIA_SERVER_MAX_PLUGIN_PROCS=6
export PLEX_MEDIA_SERVER_INFO_VENDOR=Docker
export PLEX_MEDIA_SERVER_INFO_DEVICE="Docker Container"
export PLEX_MEDIA_SERVER_INFO_MODEL=$(uname -m)
export PLEX_MEDIA_SERVER_INFO_PLATFORM_VERSION=$(uname -r)

if [ ! -d "${PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR}" ]; then
    /bin/mkdir -p "${PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR}"
    chown plex:plex "${PLEX_MEDIA_SERVER_APPLICATION_SUPPORT_DIR}"
fi

echo "[plex-setup] Starting setup UI on port 32400..."
/opt/setup-venv/bin/python /app/setup_server.py &
echo $! > "$SETUP_PID_FILE"

echo "[plex-setup] Waiting for user to complete OAuth setup..."

while [ ! -f "$SIGNAL_FILE" ]; do
    if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
        echo "[plex-setup] Timed out. Starting Plex without claim token."
        break
    fi
    sleep "$INTERVAL"
    ELAPSED=$((ELAPSED + INTERVAL))
done

# Inject the claim token
if [ -f "$SIGNAL_FILE" ]; then
    CLAIM_TOKEN="$(cat "$SIGNAL_FILE")"
    if [ -n "$CLAIM_TOKEN" ]; then
        echo "[plex-setup] Injecting PLEX_CLAIM."
        export PLEX_CLAIM="$CLAIM_TOKEN"
    fi
fi

# Kill Flask so Plex can bind 32400
if [ -f "$SETUP_PID_FILE" ]; then
    SETUP_PID="$(cat "$SETUP_PID_FILE")"
    echo "[plex-setup] Stopping setup UI, handing port 32400 to Plex."
    kill "$SETUP_PID" 2>/dev/null
    sleep 2
    kill -9 "$SETUP_PID" 2>/dev/null
    rm -f "$SETUP_PID_FILE"
fi

echo "[plex-setup] Starting Plex Media Server."
exec s6-setuidgid plex /usr/lib/plexmediaserver/Plex\ Media\ Server

#!/usr/bin/with-contenv bash
# services.d/plex-setup/run
# Waits for the setup UI to write the claim token, injects it into the
# Plex environment, then exits. s6 will not restart it (finish script handles that).

SIGNAL_FILE="/tmp/plex-claim"
TIMEOUT=600
ELAPSED=0
INTERVAL=3

echo "[plex-setup] Waiting for claim token from setup UI..."

while [ ! -f "$SIGNAL_FILE" ]; do
    if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
        echo "[plex-setup] Timed out. Starting Plex without claim token."
        # Touch a done marker so Plex service knows to start anyway
        touch /tmp/plex-setup-done
        exit 0
    fi
    sleep "$INTERVAL"
    ELAPSED=$((ELAPSED + INTERVAL))
done

CLAIM_TOKEN="$(cat "$SIGNAL_FILE")"

if [ -n "$CLAIM_TOKEN" ]; then
    echo "[plex-setup] Claim token received. Injecting PLEX_CLAIM."
    printf '%s' "$CLAIM_TOKEN" > /run/s6/container_environment/PLEX_CLAIM
fi

touch /tmp/plex-setup-done
echo "[plex-setup] Done. Plex may now start."
exit 0
